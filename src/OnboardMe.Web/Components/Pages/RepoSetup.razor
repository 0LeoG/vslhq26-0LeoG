@page "/repo-setup"
@rendermode InteractiveServer
@inject IRepositoryIngestionService RepositoryIngestionService

<PageTitle>Repo Setup</PageTitle>

<h1>Repo Setup</h1>

<AuthorizeView>
    <Authorized Context="authState">
        <p class="mb-2">
            Signed in as <strong>@authState.User.Identity?.Name</strong>.
        </p>
        <p>
            <a class="btn btn-outline-secondary" href="/auth/signout?returnUrl=/repo-setup" data-enhance-nav="false">Sign out of GitHub</a>
        </p>

        <p class="mt-4">Enter a GitHub repository URL to continue.</p>
        <EditForm Model="formModel" OnSubmit="ConnectRepository">
            <div class="mb-3">
                <label class="form-label" for="repo-url">Repository URL</label>
                <InputText id="repo-url"
                           class="form-control"
                           @bind-Value="formModel.RepositoryUrl"
                           placeholder="https://github.com/owner/repo" />
                <div class="form-text">Only root GitHub repository links are supported for now.</div>
            </div>
            <button type="submit" class="btn btn-primary" disabled="@isIngestionRunning">
                @(isIngestionRunning ? "Indexing repository..." : "Connect repository")
            </button>
        </EditForm>

        @if (isIngestionRunning)
        {
            <div class="mt-3">
                <p class="mb-2">
                    Indexing files and creating chunks...
                    @if (!string.IsNullOrWhiteSpace(currentStatus?.CurrentFilePath))
                    {
                        <span class="text-muted">(@currentStatus.CurrentFilePath)</span>
                    }
                </p>
                <div class="progress" role="progressbar" aria-label="Repository indexing progress" aria-valuenow="@ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @($"{ProgressPercent}%")">@ProgressPercent%</div>
                </div>
                <p class="form-text mt-2 mb-0">
                    Processed @currentStatus?.ProcessedFileCount of @currentStatus?.TotalFileCount files. Created @currentStatus?.ProcessedChunkCount chunks.
                </p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger mt-3" role="alert">@errorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success mt-3" role="alert">@successMessage</div>
        }

        <p class="mt-3 text-muted">
            Private repository access is not enabled in this first pass. We can add expanded GitHub scopes when private repo ingestion is implemented.
        </p>
    </Authorized>
    <NotAuthorized>
        <p>Sign in with GitHub to connect a repository.</p>
        <a class="btn btn-primary" href="/auth/signin?returnUrl=/repo-setup" data-enhance-nav="false">Sign in with GitHub</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private readonly RepositoryFormModel formModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isIngestionRunning;
    private RepositoryIndexingStatus? currentStatus;
    private int ProgressPercent => currentStatus?.TotalFileCount > 0
        ? Math.Clamp((int)((double)currentStatus.ProcessedFileCount / currentStatus.TotalFileCount * 100), 0, 100)
        : 0;

    private async Task ConnectRepository()
    {
        errorMessage = null;
        successMessage = null;
        currentStatus = null;

        if (!TryNormalizeGitHubRepositoryUrl(formModel.RepositoryUrl, out var normalizedUrl, out var validationError))
        {
            errorMessage = validationError;
            return;
        }

        if (!TryParseOwnerAndRepository(normalizedUrl, out var owner, out var repository))
        {
            errorMessage = "Could not parse repository owner and name.";
            return;
        }

        isIngestionRunning = true;
        StateHasChanged();

        RepositoryIndexingStatus? status = null;
        var ingestionTask = RepositoryIngestionService.IngestRepositoryAsync(owner, repository);
        try
        {
            while (!ingestionTask.IsCompleted)
            {
                currentStatus = await RepositoryIngestionService.GetLatestStatusAsync(owner, repository);
                StateHasChanged();
                await Task.Delay(500);
            }

            status = await ingestionTask;
            currentStatus = status;
        }
        finally
        {
            isIngestionRunning = false;
        }
        if (status is null)
        {
            errorMessage = "Repository ingestion failed unexpectedly.";
            return;
        }

        if (status.State == RepositoryIndexingState.Failed)
        {
            errorMessage = $"Repository ingestion failed: {status.ErrorMessage}";
            return;
        }

        successMessage = $"Indexed {status.IndexedCount} files, skipped {status.SkippedCount}, failed {status.FailedCount}, embedded {status.EmbeddedChunkCount} chunks.";
        if (status.State == RepositoryIndexingState.CompletedWithErrors && !string.IsNullOrWhiteSpace(status.ErrorMessage))
        {
            errorMessage = status.ErrorMessage;
        }
        formModel.RepositoryUrl = normalizedUrl;
    }

    private sealed class RepositoryFormModel
    {
        public string? RepositoryUrl { get; set; }
    }

    private static bool TryNormalizeGitHubRepositoryUrl(string? input, out string normalizedUrl, out string errorMessage)
    {
        normalizedUrl = string.Empty;
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(input))
        {
            errorMessage = "Enter a repository URL.";
            return false;
        }

        if (!Uri.TryCreate(input.Trim(), UriKind.Absolute, out var uri))
        {
            errorMessage = "Enter a valid absolute URL.";
            return false;
        }

        if (!uri.Scheme.Equals(Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Only HTTPS repository URLs are supported.";
            return false;
        }

        if (!uri.Host.Equals("github.com", StringComparison.OrdinalIgnoreCase)
            && !uri.Host.Equals("www.github.com", StringComparison.OrdinalIgnoreCase))
        {
            errorMessage = "Only github.com repository URLs are supported.";
            return false;
        }

        var path = uri.AbsolutePath.Trim('/');
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length != 2)
        {
            errorMessage = "Use a root repository URL like https://github.com/owner/repo.";
            return false;
        }

        var owner = segments[0];
        var repo = segments[1];

        if (repo.EndsWith(".git", StringComparison.OrdinalIgnoreCase))
        {
            repo = repo[..^4];
        }

        if (string.IsNullOrWhiteSpace(owner) || string.IsNullOrWhiteSpace(repo))
        {
            errorMessage = "Repository URL must include both owner and repository name.";
            return false;
        }

        normalizedUrl = $"https://github.com/{owner}/{repo}";
        return true;
    }

    private static bool TryParseOwnerAndRepository(string normalizedUrl, out string owner, out string repository)
    {
        owner = string.Empty;
        repository = string.Empty;

        if (!Uri.TryCreate(normalizedUrl, UriKind.Absolute, out var uri))
        {
            return false;
        }

        var path = uri.AbsolutePath.Trim('/');
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length != 2)
        {
            return false;
        }

        owner = segments[0];
        repository = segments[1];
        return true;
    }
}
