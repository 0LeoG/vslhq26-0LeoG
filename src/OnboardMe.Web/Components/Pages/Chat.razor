@page "/chat"
@rendermode InteractiveServer
@implements IDisposable
@inject IRepositoryIndexingStatusStore IndexingStatusStore
@inject IAzureOpenAiEmbeddingService EmbeddingService
@inject IRepositoryEmbeddingStore EmbeddingStore
@inject IAzureOpenAiChatService ChatService
@inject IConversationStore ConversationStore

<PageTitle>Chat — onboard-me</PageTitle>

<div class="chat-page">
    <div class="chat-header">
        <h1>Chat</h1>
    </div>

    @if (!hasLoadedState)
    {
        <div class="chat-body">
            <p class="text-muted">Loading…</p>
        </div>
    }
    else if (indexedRepos.Count == 0)
    {
        <div class="chat-body">
            <div class="empty-state">
                <p class="lead">No repository has been indexed yet.</p>
                <p>Go to <a href="/repo-setup">Repo Setup</a> to index a GitHub repository before using chat.</p>
            </div>
        </div>
    }
    else
    {
        <div class="chat-body">
            @* Repository selector *@
            <div class="repo-selector">
                <label class="form-label" for="repo-select">Repository</label>
                <select id="repo-select" class="form-select form-select-sm" @onchange="OnRepoSelectionChanged">
                    @foreach (var repo in indexedRepos)
                    {
                        <option value="@($"{repo.Owner}/{repo.Repository}")" selected="@(selectedOwner == repo.Owner && selectedRepository == repo.Repository)">
                            @repo.Owner/@repo.Repository@(repo.State == RepositoryIndexingState.Running ? " (indexing…)" : string.Empty)
                        </option>
                    }
                </select>
            </div>

            @if (selectedRepositoryStatus?.State == RepositoryIndexingState.Running)
            {
                <div class="indexing-banner" role="status" aria-live="polite">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>Repository is still indexing in the background.</strong>
                        <span class="text-muted small">Answers may improve as more files are processed.</span>
                    </div>
                    <div class="progress" role="progressbar" aria-label="Repository indexing progress" aria-valuenow="@SelectedRepositoryProgressPercent" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: @($"{SelectedRepositoryProgressPercent}%")">
                            @SelectedRepositoryProgressPercent%
                        </div>
                    </div>
                    <div class="form-text mt-2 mb-0">
                        Processed @selectedRepositoryStatus.ProcessedFileCount of @selectedRepositoryStatus.TotalFileCount files.
                        Embedded @selectedRepositoryStatus.EmbeddedChunkCount chunks.
                    </div>
                </div>
            }

            <div class="start-here-panel">
                <h2 class="h5 mb-1">Where should I start?</h2>
                <p class="text-muted mb-2" style="font-size:13px;">Describe what you need to change, then get suggested files to read first.</p>

                <EditForm Model="startHereInputModel" OnSubmit="SuggestStartingFiles">
                    <div class="input-group">
                        <InputText class="form-control form-control-sm"
                                   @bind-Value="startHereInputModel.TaskPrompt"
                                   placeholder="Example: I need to change auth"
                                   disabled="@isLoading"
                                   aria-label="Task prompt" />
                        <button type="submit" class="btn btn-outline-primary btn-sm" disabled="@(isLoading || string.IsNullOrWhiteSpace(startHereInputModel.TaskPrompt))">
                            Suggest files
                        </button>
                    </div>
                </EditForm>

                @if (!string.IsNullOrWhiteSpace(startHereMessage))
                {
                    <p class="text-muted mt-2 mb-0" style="font-size:12px;">@startHereMessage</p>
                }

                @if (startHereSuggestions.Count > 0)
                {
                    <ul class="start-here-list mt-2 mb-0">
                        @foreach (var suggestion in startHereSuggestions)
                        {
                            <li>
                                <a href="https://github.com/@selectedOwner/@selectedRepository/blob/HEAD/@suggestion.Path"
                                   target="_blank"
                                   rel="noopener noreferrer">@suggestion.Path</a>
                                <div class="text-muted" style="font-size:12px;">@suggestion.Reason</div>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="message-list-controls">
                <span class="text-muted small">
                    @if (messages.Count > 0)
                    {
                        <span>@messages.Count message@(messages.Count == 1 ? "" : "s") in this conversation</span>
                    }
                </span>
                @if (messages.Count > 0)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="NewConversationAsync" disabled="@isLoading">
                        New conversation
                    </button>
                }
            </div>

            <div class="message-list-wrapper" aria-live="polite" aria-label="Chat messages">
                @if (messages.Count == 0)
                {
                    <div class="empty-state">
                        <p>Ask a question about <strong>@selectedOwner/@selectedRepository</strong> to get started.</p>
                    </div>
                }
                else
                {
                    @foreach (var msg in messages)
                    {
                        <div class="message-item">
                            <div class="message-question">
                                <span class="badge bg-primary">You</span>
                                @msg.Question
                            </div>

                            @if (msg.IsLoading)
                            {
                                <div class="message-answer loading-answer" role="status">
                                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                    Thinking&hellip;
                                </div>
                            }
                            else if (msg.ErrorMessage is not null)
                            {
                                <div class="message-answer">
                                    <div class="alert alert-danger mb-0" role="alert">
                                        <strong>Error:</strong> @msg.ErrorMessage
                                    </div>
                                </div>
                            }
                            else if (msg.IsClarification)
                            {
                                <div class="message-answer">
                                    <span class="badge bg-warning me-2">Clarification needed</span>
                                    <span class="answer-text">@msg.Answer</span>
                                </div>
                            }
                            else
                            {
                                <div class="message-answer">
                                    <span class="badge bg-secondary me-2">Assistant</span>
                                    <span class="answer-text">@msg.Answer</span>
                                </div>

                                @if (msg.Citations.Count > 0)
                                {
                                    <div class="citations">
                                        <span class="citations-label">Sources:</span>
                                        @foreach (var citation in msg.Citations)
                                        {
                                            <a class="citation-link"
                                               href="https://github.com/@selectedOwner/@selectedRepository/blob/HEAD/@citation.Path#L@citation.StartLine-L@citation.EndLine"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               title="@citation.Path lines @citation.StartLine–@citation.EndLine">
                                                @citation.Path
                                                <span class="citation-lines">(L@citation.StartLine–@citation.EndLine)</span>
                                            </a>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @* Sticky chat input *@
        <div class="chat-input-area">
            <EditForm Model="inputModel" OnSubmit="SendMessage">
                <div class="input-group">
                    <InputText id="chat-question"
                               class="form-control"
                               @bind-Value="inputModel.Question"
                               placeholder="Ask a question about this repository…"
                               disabled="@isLoading"
                               aria-label="Question" />
                    <button type="submit" class="btn btn-primary" disabled="@(isLoading || string.IsNullOrWhiteSpace(inputModel.Question))">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                        }
                        Send
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    // -------------------------------------------------------------------------
    // State
    // -------------------------------------------------------------------------

    private bool hasLoadedState;
    private bool isLoading;
    private string selectedOwner = string.Empty;
    private string selectedRepository = string.Empty;
    private IReadOnlyList<RepositoryIndexingStatus> indexedRepos = [];
    private RepositoryIndexingStatus? selectedRepositoryStatus;
    private readonly List<ChatMessageModel> messages = [];
    private readonly StartHereInputModel startHereInputModel = new();
    private IReadOnlyList<StartHereSuggestion> startHereSuggestions = [];
    private string? startHereMessage;
    private CancellationTokenSource? statusPollingCts;

    // Stable per-component session ID used to isolate conversation history in the store.
    private string sessionId = Guid.NewGuid().ToString("N");

    private readonly ChatInputModel inputModel = new();
    private int SelectedRepositoryProgressPercent => selectedRepositoryStatus?.TotalFileCount > 0
        ? Math.Clamp((int)((double)selectedRepositoryStatus.ProcessedFileCount / selectedRepositoryStatus.TotalFileCount * 100), 0, 100)
        : 0;

    // -------------------------------------------------------------------------
    // Lifecycle
    // -------------------------------------------------------------------------

    protected override async Task OnInitializedAsync()
    {
        await RefreshRepositoryStatusesAsync();
        StartStatusPolling();

        hasLoadedState = true;
    }

    // -------------------------------------------------------------------------
    // Event handlers
    // -------------------------------------------------------------------------

    private async Task OnRepoSelectionChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        var slash = value.IndexOf('/');
        if (slash > 0)
        {
            selectedOwner = value[..slash];
            selectedRepository = value[(slash + 1)..];
        }

        selectedRepositoryStatus = indexedRepos.FirstOrDefault(repo =>
            string.Equals(repo.Owner, selectedOwner, StringComparison.OrdinalIgnoreCase)
            && string.Equals(repo.Repository, selectedRepository, StringComparison.OrdinalIgnoreCase));

        // Clear conversation state when the user switches repos.
        await ClearConversationStateAsync();
        startHereSuggestions = [];
        startHereMessage = null;
    }

    private async Task SendMessage()
    {
        var question = inputModel.Question?.Trim();
        if (string.IsNullOrWhiteSpace(question) || isLoading)
        {
            return;
        }

        inputModel.Question = string.Empty;
        isLoading = true;

        // Add a placeholder message that shows the loading spinner.
        var placeholder = new ChatMessageModel { Question = question, IsLoading = true };
        messages.Add(placeholder);
        StateHasChanged();

        try
        {
            var currentEmbeddings = await EmbeddingStore.GetRepositoryEmbeddingsAsync(selectedOwner, selectedRepository);
            if (currentEmbeddings.Count == 0)
            {
                placeholder.IsLoading = false;
                placeholder.ErrorMessage = "No embeddings are available yet for this repository. Wait for indexing progress and try again.";
                return;
            }

            // Load recent conversation history from the store.
            var history = await ConversationStore.GetHistoryAsync(sessionId, selectedOwner, selectedRepository);

            // Step 1: rewrite follow-up questions into standalone retrieval queries.
            var retrievalQuery = await ChatService.RewriteQueryAsync(question, history);

            // Step 2: embed the (possibly rewritten) retrieval query.
            var queryChunk = new RepositoryContentChunk
            {
                ChunkId    = "query:0",
                SourcePath = "__query__",
                SourceSha  = string.Empty,
                ChunkIndex = 0,
                Strategy   = "query",
                StartLine  = 0,
                EndLine    = 0,
                Content    = retrievalQuery
            };

            IReadOnlyList<RepositoryChunkEmbeddingRecord> queryEmbeddings;
            queryEmbeddings = await EmbeddingService.GenerateEmbeddingsAsync(
                selectedOwner, selectedRepository, [queryChunk]);

            // Step 3: retrieve the most relevant chunks.
            var queryEmbedding = queryEmbeddings[0].Embedding;
            var contextChunks = await EmbeddingStore.SearchByEmbeddingAsync(
                selectedOwner, selectedRepository, queryEmbedding);

            // Step 4: call the chat model for a grounded answer, including conversation history.
            var chatAnswer = await ChatService.AnswerAsync(
                selectedOwner, selectedRepository, question, contextChunks, history);

            placeholder.IsLoading      = false;
            placeholder.Answer         = chatAnswer.Answer;
            placeholder.Citations      = chatAnswer.Citations;
            placeholder.IsClarification = chatAnswer.IsClarification;

            // Persist both sides of the turn to the conversation store.
            await ConversationStore.AddMessageAsync(sessionId, selectedOwner, selectedRepository,
                new ConversationMessage { Role = ConversationRole.User, Content = question });
            await ConversationStore.AddMessageAsync(sessionId, selectedOwner, selectedRepository,
                new ConversationMessage { Role = ConversationRole.Assistant, Content = chatAnswer.Answer });
        }
        catch (Exception ex)
        {
            placeholder.IsLoading = false;
            placeholder.ErrorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task NewConversationAsync()
    {
        await ClearConversationStateAsync();
        StateHasChanged();
    }

    private async Task ClearConversationStateAsync()
    {
        messages.Clear();
        await ConversationStore.ClearAsync(sessionId, selectedOwner, selectedRepository);
    }

    private void StartStatusPolling()
    {
        statusPollingCts?.Cancel();
        statusPollingCts?.Dispose();
        statusPollingCts = new CancellationTokenSource();
        var cancellationToken = statusPollingCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                while (!cancellationToken.IsCancellationRequested)
                {
                    await RefreshRepositoryStatusesAsync();
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(1000, cancellationToken);
                }
            }
            catch (OperationCanceledException)
            {
                // Normal cancellation on page disposal.
            }
        }, cancellationToken);
    }

    private async Task RefreshRepositoryStatusesAsync()
    {
        var all = await IndexingStatusStore.ListAsync();
        indexedRepos = all
            .Where(r => r.State is not RepositoryIndexingState.Failed)
            .OrderBy(r => $"{r.Owner}/{r.Repository}", StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (indexedRepos.Count == 0)
        {
            selectedOwner = string.Empty;
            selectedRepository = string.Empty;
            selectedRepositoryStatus = null;
            return;
        }

        var selectedStillExists = indexedRepos.Any(repo =>
            string.Equals(repo.Owner, selectedOwner, StringComparison.OrdinalIgnoreCase)
            && string.Equals(repo.Repository, selectedRepository, StringComparison.OrdinalIgnoreCase));

        if (!selectedStillExists)
        {
            selectedOwner = indexedRepos[0].Owner;
            selectedRepository = indexedRepos[0].Repository;
        }

        selectedRepositoryStatus = indexedRepos.FirstOrDefault(repo =>
            string.Equals(repo.Owner, selectedOwner, StringComparison.OrdinalIgnoreCase)
            && string.Equals(repo.Repository, selectedRepository, StringComparison.OrdinalIgnoreCase));
    }

    public void Dispose()
    {
        statusPollingCts?.Cancel();
        statusPollingCts?.Dispose();
    }

    private void SuggestStartingFiles()
    {
        var prompt = startHereInputModel.TaskPrompt?.Trim();
        if (string.IsNullOrWhiteSpace(prompt))
        {
            return;
        }

        var selectedRepo = indexedRepos.FirstOrDefault(repo =>
            string.Equals(repo.Owner, selectedOwner, StringComparison.OrdinalIgnoreCase)
            && string.Equals(repo.Repository, selectedRepository, StringComparison.OrdinalIgnoreCase));

        if (selectedRepo is null)
        {
            startHereSuggestions = [];
            startHereMessage = "Select a repository first.";
            return;
        }

        startHereSuggestions = StartHereGuideGenerator.CreateSuggestions(prompt, selectedRepo.Files);
        startHereMessage = startHereSuggestions.Count == 0
            ? "No starter files found yet. Try a more specific task prompt."
            : "Simple keyword-based suggestions for now; this can be improved with richer repo mapping later.";
    }

    // -------------------------------------------------------------------------
    // Inner models
    // -------------------------------------------------------------------------

    /// <summary>View-model for a single turn in the conversation.</summary>
    private sealed class ChatMessageModel
    {
        public required string Question { get; init; }
        public bool IsLoading { get; set; }
        public string? Answer { get; set; }
        public string? ErrorMessage { get; set; }
        public bool IsClarification { get; set; }
        public IReadOnlyList<FileCitation> Citations { get; set; } = [];
    }

    /// <summary>Bound model for the question input field.</summary>
    private sealed class ChatInputModel
    {
        public string? Question { get; set; }
    }

    /// <summary>Bound model for the guided start prompt.</summary>
    private sealed class StartHereInputModel
    {
        public string? TaskPrompt { get; set; }
    }
}
